# Runtime Nginx configuration.
#
# Rendered by the base image's entrypoint, which substitutes only
# ${GREENHOUSE_API_UPSTREAM} because NGINX_ENVSUBST_FILTER names it. Changing
# that variable and restarting the container repoints the proxy without
# rebuilding a single asset — the browser bundle contains no backend host.

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Container-local liveness. Not proxied, so it answers even when the
    # greenhouse backend is unreachable — the portal is still being served.
    # The exact-match modifier keeps it distinct from the backend's own
    # /health, which is proxied below.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain always;
        return 200 "ok\n";
    }

    # The versioned domain API. `proxy_pass` carries no URI part on purpose:
    # Nginx then forwards the original request URI unchanged, so both the path
    # and the query string reach the backend exactly as the browser sent them.
    location /api/v1 {
        proxy_pass ${GREENHOUSE_API_UPSTREAM};
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        proxy_connect_timeout 5s;
        proxy_send_timeout    30s;
        proxy_read_timeout    30s;

        # A polling client should be told quickly that the backend is down, so
        # it can show the unavailable state rather than hang.
        proxy_next_upstream off;
    }

    # The backend's health endpoint, which it publishes unversioned. It is how
    # the portal reports cloud API availability, so it is part of the same
    # same-origin boundary as /api/v1. Matched exactly: it must proxy /health
    # and nothing else.
    location = /health {
        proxy_pass ${GREENHOUSE_API_UPSTREAM};
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        proxy_connect_timeout 5s;
        proxy_send_timeout    10s;
        proxy_read_timeout    10s;

        proxy_next_upstream off;
    }

    # Hashed build assets are immutable: a changed file gets a new name.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # The SPA entry point must never be cached for long, or a browser would keep
    # loading an old bundle that references deleted asset hashes.
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate" always;
    }

    # SPA fallback, so a browser refresh on any portal route serves the
    # application rather than a 404. `/api/v1` and `/health` are matched by
    # their own locations above, so they are never swallowed by this rule.
    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
}
