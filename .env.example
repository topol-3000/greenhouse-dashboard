# Frontend configuration for the AI Greenhouse Customer Portal.
#
# Copy to `.env.local` to change it for local development. Every variable is
# read at build time, so a change needs a rebuild of the bundle. The Docker
# runtime image does not need this file: it proxies the backend at run time
# through GREENHOUSE_API_UPSTREAM instead.

# Base URL of the AI Greenhouse cloud API. Both the versioned `/api/v1` surface
# and the unversioned `/health` endpoint are derived from it.
#
# Leave empty (the default) to call the same origin that serves the portal,
# which is what the bundled Nginx runtime and the Vite dev server proxy expect.
# Set an absolute path (`/greenhouse-api`) for a proxy on a sub-path, or an
# absolute URL (`https://api.example.com`) to reach the backend cross-origin —
# which requires the backend to allow that origin.
VITE_API_BASE_URL=
